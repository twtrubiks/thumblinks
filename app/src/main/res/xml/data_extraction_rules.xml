<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以後的雲端備份與換手機時的直接傳輸，規則同 backup_rules.xml（Android 11 以前用那份，兩份要一樣） -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="thumbs" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="thumbs" />
    </device-transfer>
</data-extraction-rules>
